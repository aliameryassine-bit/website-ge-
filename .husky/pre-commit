#!/usr/bin/env sh

# Lint and format staged files, then check the fact system in commit mode.
#
# Commit mode fails on real mistakes — an unknown fact id, or a fact claiming
# verified/internal status with no source — but not on referenced PLACEHOLDERs.
# Those are an intentional interim state (the footer's registration details are
# placeholders because nobody has supplied them yet), and they are blocked at
# the point that matters: `npm run build`. Failing commits on them would only
# train everyone to pass --no-verify.
npx lint-staged
npm run check:facts:commit
