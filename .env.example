# Green Exchange — environment configuration
#
# Copy to .env.local for development. Never commit a filled-in copy.
#
# The site runs with none of these set. What changes is what happens on
# submission: with no delivery configured, both lead forms validate correctly
# and then report failure with a fallback address rather than pretending to
# have sent. That is deliberate — a form that returns success and discards the
# submission is worse than a broken one, because the person stops chasing.

# ---------------------------------------------------------------------------
# Lead delivery — email (Resend)
# ---------------------------------------------------------------------------
# Verify the sending domain in Resend first, or delivery will fail with a 403.
# The from address must be on that domain. The reply-to is set per submission
# to the lead's own address, so replying from the inbox reaches them.
RESEND_API_KEY=
LEADS_FROM_EMAIL=
# Comma-separated for more than one recipient.
LEADS_TO_EMAIL=

# ---------------------------------------------------------------------------
# Lead delivery — row store (Airtable)
# ---------------------------------------------------------------------------
# A personal access token with data.records:write on the base, plus the base id
# (starts with "app"). Table names must match the tables in the base.
#
# Columns expected on "Pilot requests":
#   Reference · Company · Email · Stores · Role · City · Received at ·
#   Consent version · Consent text · Source
#
# Columns expected on "Data room requests":
#   Reference · Name · Organisation · Role · Investor type · Country · Email ·
#   LinkedIn · Received at · Declaration version · Consent version ·
#   Consent text · Status · Source
#
# Add a Status single-select to run the pipeline from the table itself.
# Writes use typecast, so a column that is text where a number was sent still
# accepts the row — a rejected write is a lost lead.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_PILOT_TABLE=Pilot requests
AIRTABLE_DATA_ROOM_TABLE=Data room requests

# ---------------------------------------------------------------------------
# Form integrity
# ---------------------------------------------------------------------------
# Signs the anti-spam timing token and salts the rate-limit key. 32+ chars.
#   openssl rand -base64 48
# Without it, timing tokens are unsigned: the window is still enforced, so
# naive bots are still caught, but the elapsed time can be edited by anything
# that bothers to. Set it in production.
FORM_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Data room access tokens (separate from the request flow)
# ---------------------------------------------------------------------------
# Signs the time-limited access URLs minted by scripts/grant-data-room.ts.
# Nothing in the request flow can mint one. 32+ chars.
DATA_ROOM_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Analytics (Plausible) — see docs/analytics.md
# ---------------------------------------------------------------------------
# The site as registered in Plausible, e.g. greenexchange.com. This is the only
# analytics variable that reaches the browser, and it is a hostname, not a
# secret. Without it no script renders at all — deliberately, rather than a
# script pointing at a site that does not exist in any account.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Self-hosted instance. Defaults to https://plausible.io.
PLAUSIBLE_HOST=
# Read-only Stats API key, for the /admin dashboard only. Never public.
PLAUSIBLE_API_KEY=

# No cookie banner is required for this configuration. Plausible stores nothing
# on the device and holds no personal data, and the one cookie this site does
# set (gx_t, the anti-spam token) is strictly necessary and exempt. Adding any
# marketing pixel changes that answer — the reasoning is in docs/analytics.md.

# ---------------------------------------------------------------------------
# Admin dashboard
# ---------------------------------------------------------------------------
# HTTP Basic Auth on /admin. 12 characters minimum; the route returns 503 rather
# than opening if this is unset or too short.
#   openssl rand -base64 24
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Public origin
# ---------------------------------------------------------------------------
# Absolute canonical, hreflang and Open Graph URLs are built from this. Baked in
# at BUILD time for static pages, so it must be set when building, not only when
# serving. Without it every canonical points at localhost.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Test seams — leave unset in production
# ---------------------------------------------------------------------------
# Point the two delivery calls at a local stand-in to exercise the full
# submission path without live accounts or real leads.
# RESEND_BASE_URL=http://127.0.0.1:4111
# AIRTABLE_BASE_URL=http://127.0.0.1:4111
