{
  "name": "green-exchange",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run check:facts && npm run check:legal && npm run check:i18n",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:facts": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-facts.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "check:facts:commit": "npm run check:facts -- --commit",
    "check:legal": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-legal.ts",
    "grant:data-room": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/grant-data-room.ts",
    "build:messages": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/build-messages.ts",
    "check:i18n": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/check-i18n.ts",
    "audit:lighthouse": "node scripts/audit/lighthouse.mjs",
    "audit:axe": "node scripts/audit/axe.mjs",
    "audit:keyboard": "node scripts/audit/keyboard.mjs",
    "audit:bundle": "node scripts/audit/bundle-audit.mjs",
    "audit:fonts": "node scripts/audit/font-audit.mjs"
  },
  "dependencies": {
    "lenis": "^1.1.20",
    "motion": "^13.1.0",
    "next": "^16.3.0",
    "next-intl": "^4.13.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.1",
    "lint-staged": "^15.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,json,css,md}": [
      "prettier --write"
    ]
  }
}
